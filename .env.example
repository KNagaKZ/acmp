# Server-only app role connection. Copy the HOST from Supabase > Connect > Transaction pooler.
DATABASE_URL=postgresql://acmp_app.PROJECT_REF:APP_ROLE_PASSWORD@POOLER_HOST:6543/postgres
# Generate a long random secret for signed login cookies.
AUTH_SECRET=replace-with-a-long-random-secret

# Only for schema installation or importing SQLite; remove after setup.
# DATABASE_ADMIN_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER_HOST:5432/postgres

# Only for a local Postgres instance without TLS. Supabase always uses TLS.
# DATABASE_SSL=disable
